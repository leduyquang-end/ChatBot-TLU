# Khóa API - bắt buộc
GROQ_API_KEY=your-groq-api-key
QWEN_API_KEY=your-qwen-api-key
# Token Hugging Face (giá trị "your-..." được coi là chưa cấu hình — model công khai vẫn tải được)
HF_TOKEN=your-huggingface-token
# Khóa ký token (bắt buộc khi chạy thật; thiếu → dùng secret dev + cảnh báo log)
APP_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Tùy chọn LLM (mặc định DashScope; trỏ sang OpenRouter bằng base URL + model free)
# Ví dụ OpenRouter bản free (nhiều model cách nhau dấu phẩy = fallback lần lượt):
# QWEN_BASE_URL=https://openrouter.ai/api/v1
# ANSWER_MODEL=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3-ultra-550b-a55b:free,xingchen-agi/xing4.0-29b-a4b:free
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ANSWER_MODEL=qwen3-235b-a22b

# Kho tri thức - bắt buộc
CHROMA_URL=http://localhost:8001
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Ứng dụng
APP_PORT=8010
FRONTEND_PORT=8080
LOG_LEVEL=INFO

# Tham số thuật toán (mặc định, không bắt buộc)
CHUNK_SIZE=800
CHUNK_OVERLAP=120
FETCH_K=10
TOP_K=5
ALPHA=0.7
DEDUP_THRESHOLD=0.92
EMBEDDING_DIM=768
EMBEDDING_MAX_TOKENS=256
NO_INFO_THRESHOLD=0.15
REQUEST_TIMEOUT_SECONDS=30
RETRY_BACKOFF_SECONDS=0.5
MAX_RETRIES=3
HISTORY_MAX_TURNS=10
QUESTION_MAX_LENGTH=2000
REFRESH_TOKEN_TTL_HOURS=720

# Cơ sở dữ liệu (mặc định SQLite - lưu lịch sử hội thoại/tài khoản thật khi cần)
DATABASE_URL=sqlite:///data/chatbot_tlu.db
